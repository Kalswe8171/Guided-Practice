from datetime import datetime

print("Kalswe8171 Spreadsheet Automation Menu")

# Store the menu options in a list
menuOptions = [
    "1. Input Data",
    "2. View Current Data",
    "3. Generate Report"
]

# Use a for-loop to display each menu option
for option in menuOptions:
    print(option)

# The next line retrieves the inputted option and stores into the variable called choice.
choice = input("Enter your option number (1-3): ")

# Check if the selected option is valid
if choice == "1" or choice == "2" or choice == "3":
    print(f"Option {choice} has been selected.")
    print("The current date and time is", str(datetime.now()))
else:
    print("Error: Invalid choice selected.")
